# Copy this file to .env and fill in real values before deploying to production.

# Port the Express API server listens on.
PORT=4000

# Secret used to sign admin login tokens (JWTs). MUST be set to a long,
# random value in production — never use the default dev value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Credentials for the initial admin account, created automatically the
# first time the server starts (only if no admin account exists yet).
ADMIN_EMAIL=admin@dgntechmobiles.co.uk
ADMIN_PASSWORD=

# Optional: override where the SQLite database file is stored.
# DB_PATH=/absolute/path/to/shop.sqlite

# The public URL of the frontend, used to build Stripe Checkout's redirect
# links. In development this is the Vite dev server.
CLIENT_URL=http://localhost:5173

# Stripe secret key (server-side only — starts with sk_test_ or sk_live_).
# Get this from https://dashboard.stripe.com/apikeys — use a test-mode key
# while developing, and only switch to a live key when going live.
# NEVER commit a real key or expose it to the frontend.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_), used to verify that
# webhook requests genuinely come from Stripe. Get this from the webhook
# endpoint's settings in the Stripe Dashboard (or from the Stripe CLI when
# testing locally with `stripe listen`).
STRIPE_WEBHOOK_SECRET=
