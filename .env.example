# Copy this file to .env and fill in real values before deploying to production.

# Port the Express API server listens on.
PORT=4000

# Secret used to sign admin login tokens (JWTs). MUST be set to a long,
# random value in production — never use the default dev value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Credentials for the initial admin account, created automatically the
# first time the server starts (only if no admin account exists yet).
ADMIN_EMAIL=admin@dgntechmobiles.co.uk
ADMIN_PASSWORD=

# Optional: override where the SQLite database file is stored.
# DB_PATH=/absolute/path/to/shop.sqlite
