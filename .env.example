# Copy to .env.local for development:  cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials.
# Deployed environments read from a managed secret store, not from files.

# ---- Application ----
APP_ENV=local                      # local | test | staging | production
APP_URL=http://localhost:3000

# NODE_ENV is deliberately absent. Next.js sets it itself — `development` for
# `next dev`, `production` for `next build`. Pinning it here and exporting the
# file into a shell makes `pnpm build` produce a development bundle, which then
# fails to prerender.

# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql://kurdora:kurdora_local_dev@localhost:5432/kurdora?schema=public

# Scratch database Prisma Migrate diffs against. Leave empty locally and Prisma
# creates a temporary one; set it where the DB user cannot CREATE DATABASE.
SHADOW_DATABASE_URL=

# ---- Object storage ----
# Where the local driver writes uploaded and re-encoded images in development.
# Defaults to ./.storage (gitignored). Production requires the S3 driver
# instead; the app refuses to start without it.
LOCAL_STORAGE_DIR=

# Database integration tests (tests/db/*) run only when this is set. They create
# and drop their own throwaway databases, so point it at a LOCAL server only.
TEST_DATABASE_URL=postgresql://kurdora:kurdora_local_dev@localhost:5432/kurdora_test?schema=public

# ---- Redis (cache, queues, rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Phase 3) ----
# Signs access tokens (JWT, HS256). At least 32 characters.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Encrypts TOTP secrets at rest (AES-256-GCM). EXACTLY 64 hex characters.
# Generate with: openssl rand -hex 32
# Rotating this makes every enrolled authenticator unreadable — enrolled users
# would have to fall back to recovery codes and re-enrol.
AUTH_ENCRYPTION_KEY=

# ---- Object storage (Phase 4; MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=kurdora-local
S3_ACCESS_KEY_ID=kurdora
S3_SECRET_ACCESS_KEY=kurdora_local_dev

# ---- Mail (Phase 5; Mailpit locally) ----
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@kurdora.local

# ---- Stripe (Phase 7 Part 1 — TEST MODE ONLY) ----
#
# Use `sk_test_…` keys ONLY. A live key is REFUSED at startup: live mode is
# gated on Stripe's written approval of the platform business model, which does
# not exist (R-3, docs/15-phase-7-gate.md B-1). See src/infra/stripe/config.ts.
#
# Both are server-side only and must never be prefixed NEXT_PUBLIC_. Leave them
# empty to run without payments — the payment routes then answer 503 rather
# than failing at the first charge.
#
# The webhook secret comes from `stripe listen`, or from the endpoint you
# registered. Without it a payment could be created that nothing can confirm,
# so a secret key without a webhook secret is refused as well.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The publishable key is NOT a secret, but it is still served to the browser by
# a server component rather than inlined at build time, so one rule covers
# every key: nothing Stripe-related is NEXT_PUBLIC_. Needed in Part 2, when the
# payment UI exists.
STRIPE_PUBLISHABLE_KEY=
