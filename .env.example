# Copy to .env.local for development:  cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials.
# Deployed environments read from a managed secret store, not from files.

# ---- Application ----
APP_ENV=local                      # local | test | staging | production
APP_URL=http://localhost:3000

# NODE_ENV is deliberately absent. Next.js sets it itself — `development` for
# `next dev`, `production` for `next build`. Pinning it here and exporting the
# file into a shell makes `pnpm build` produce a development bundle, which then
# fails to prerender.

# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql://kurdora:kurdora_local_dev@localhost:5432/kurdora?schema=public

# Scratch database Prisma Migrate diffs against. Leave empty locally and Prisma
# creates a temporary one; set it where the DB user cannot CREATE DATABASE.
SHADOW_DATABASE_URL=

# ---- Object storage ----
# Where the local driver writes uploaded and re-encoded images in development.
# Defaults to ./.storage (gitignored). Production requires the S3 driver
# instead; the app refuses to start without it.
LOCAL_STORAGE_DIR=

# Database integration tests (tests/db/*) run only when this is set. They create
# and drop their own throwaway databases, so point it at a LOCAL server only.
TEST_DATABASE_URL=postgresql://kurdora:kurdora_local_dev@localhost:5432/kurdora_test?schema=public

# ---- Redis (cache, queues, rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Phase 3) ----
# Signs access tokens (JWT, HS256). At least 32 characters.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Encrypts TOTP secrets at rest (AES-256-GCM). EXACTLY 64 hex characters.
# Generate with: openssl rand -hex 32
# Rotating this makes every enrolled authenticator unreadable — enrolled users
# would have to fall back to recovery codes and re-enrol.
AUTH_ENCRYPTION_KEY=

# ---- Object storage (Phase 4; MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=kurdora-local
S3_ACCESS_KEY_ID=kurdora
S3_SECRET_ACCESS_KEY=kurdora_local_dev

# ---- Mail (Phase 5; Mailpit locally) ----
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@kurdora.local

# ---- Stripe (TEST MODE ONLY — Kurdora's own service billing) ----
#
# Stripe bills SELLERS for KURDORA'S OWN service: keeping a listing active
# (ADR-0015). It is NOT Stripe Connect and NOT a marketplace payment — there is
# no connected account, destination charge, application fee, transfer or
# payout, and the sale of a listed item never passes through Stripe (ADR-0014).
#
# Use `sk_test_…` ONLY. A live key is REFUSED at startup; see
# src/infra/stripe/config.ts. Leave both empty to run without billing — the
# subscription routes then answer 503 rather than failing at the first charge.
#
# Both are server-side only and must never be prefixed NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The publishable key. NOT REQUIRED — leave it unset.
#
# `clientEnv()` is its only reader and still has no call sites: Stripe-hosted
# Checkout needs no client-side key. Note the name: `STRIPE_PUBLISHABLE_KEY`,
# which this file once listed, is read by nothing.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Verifying Stripe TEST MODE
# ─────────────────────────────────────────────────────────────────────────────
#
# FULL RUNBOOK: docs/17-stripe-test-mode-setup.md — Dashboard steps, the
# test-Price script, CLI commands, the webhook path and the walkthrough.
#
#   1. Sandbox (test mode) Stripe account. Connect does NOT need enabling.
#   2. STRIPE_SECRET_KEY=sk_test_… from the Dashboard.
#   3. pnpm db:deploy && pnpm stripe:setup-test-plan
#      Creates the Stripe Product and Price FROM the service_plans row and
#      links it. Refuses to run outside test mode, and refuses to link a price
#      that disagrees with the plan.
#   4. stripe login
#      stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
#      Take the whsec_… it prints ON START — not one from a Dashboard
#      endpoint — as STRIPE_WEBHOOK_SECRET, then restart `pnpm dev`.
#   5. pnpm verify && pnpm exec vitest run tests/api/stripe-live.test.ts
#      Those tests SKIP without a key. Them running is the signal that real
#      verification happened.
#   6. Subscriptions are OFF until an admin sets
#      listing.subscription_required = true. Turning it on takes every unpaid
#      listing down, so do it on a test database first.
#
# `stripe trigger` events carry fake data that does NOT correlate to your
# subscriptions, so they verify signature handling and idempotency but cannot
# prove an event updated the right listing. Complete a real test checkout for
# that. Test cards: 4242 4242 4242 4242 succeeds; 4000 0000 0000 0341 fails on
# a later charge (use a short trial to defer it) and drives PAST_DUE.
